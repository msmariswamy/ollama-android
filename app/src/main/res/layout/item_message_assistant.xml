<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="start"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:paddingStart="8dp"
    android:paddingEnd="56dp">

    <!-- AI avatar -->
    <TextView
        android:id="@+id/tvAvatarAi"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_avatar"
        android:gravity="center"
        android:text="✦"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:layout_gravity="top"/>

    <!-- Bubble column -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_weight="1">

        <!-- Thinking section -->
        <LinearLayout
            android:id="@+id/tvThinking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bubble_thinking"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thinking…"
                android:textColor="@color/colorPrimary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvThinkingContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="260dp"
                android:textColor="#6060A0"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp"
                android:textStyle="italic"
                android:textIsSelectable="true"/>
        </LinearLayout>

        <!-- Main response area: contains Markwon TextViews and code block views -->
        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bubble_assistant"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"/>

        <!-- Action row: Copy / Regenerate / Thumbs up / Thumbs down -->
        <LinearLayout
            android:id="@+id/actionRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnCopy"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_action_copy"
                android:tint="@color/colorTextMuted"
                android:contentDescription="Copy message"
                android:padding="6dp"/>

            <ImageButton
                android:id="@+id/btnRegenerate"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_action_refresh"
                android:tint="@color/colorTextMuted"
                android:contentDescription="Regenerate"
                android:padding="6dp"/>

            <ImageButton
                android:id="@+id/btnThumbUp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_action_thumb_up"
                android:tint="@color/colorTextMuted"
                android:contentDescription="Thumbs up"
                android:padding="6dp"/>

            <ImageButton
                android:id="@+id/btnThumbDown"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_action_thumb_down"
                android:tint="@color/colorTextMuted"
                android:contentDescription="Thumbs down"
                android:padding="6dp"/>

        </LinearLayout>

    </LinearLayout>
</LinearLayout>
