<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_code_block"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp">

    <!-- Header: language label + copy button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:background="@color/colorCodeBlockHeader">

        <TextView
            android:id="@+id/tvCodeLanguage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/colorCodeLang"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.04"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopyCode"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="Copy"
            android:textSize="11sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textColor="@color/colorCodeLang"
            app:strokeColor="@color/colorCodeLang"
            app:strokeWidth="1dp"
            app:cornerRadius="4dp"
            xmlns:app="http://schemas.android.com/apk/res-auto"/>
    </LinearLayout>

    <!-- Code content -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="horizontal"
        android:fadeScrollbars="true">

        <TextView
            android:id="@+id/tvCodeContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textColor="@color/colorCodeText"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:textIsSelectable="true"/>
    </HorizontalScrollView>
</LinearLayout>
