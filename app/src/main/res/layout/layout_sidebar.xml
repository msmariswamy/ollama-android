<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <!-- Top bar: Chats title + new chat button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Chats"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"/>

        <ImageButton
            android:id="@+id/btnNewChat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_edit_title"
            android:tint="@color/colorTextPrimary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="New chat"/>

    </LinearLayout>

    <!-- Search bar row -->
    <LinearLayout
        android:id="@+id/searchRow"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/colorCard"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Search chats"
            android:textSize="14sp"
            android:textColor="@color/colorTextMuted"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⌘K"
            android:textSize="11sp"
            android:textColor="@color/colorTextMuted"
            android:fontFamily="monospace"/>

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/colorBorder"
        android:layout_marginBottom="4dp"/>

    <!-- Conversation list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSidebarConversations"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:clipToPadding="false"
        android:scrollbars="none"/>

    <!-- Bottom row: connection info + settings -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:background="@color/colorBackground">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/colorBorder"
            android:layout_gravity="top"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:background="@color/colorBackground">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvConnectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Local server"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"/>

            <TextView
                android:id="@+id/tvConnectionDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connected"
                android:textSize="11sp"
                android:textColor="@color/colorTextMuted"/>

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSidebarSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_attach_file"
            android:tint="@color/colorTextMuted"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"/>

    </LinearLayout>

</LinearLayout>
