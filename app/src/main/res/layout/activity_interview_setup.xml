<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorBackground">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fitsSystemWindows="true"
            android:background="@color/colorBackground"
            app:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/colorBackground"
                app:navigationIconTint="@color/colorTextPrimary"
                app:title="Interview Assistant"
                app:titleTextColor="@color/colorTextPrimary"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/colorBorder"/>

        </com.google.android.material.appbar.AppBarLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Header icon + description -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="24dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_interview"
                        android:tint="@color/colorPrimary"
                        android:contentDescription="@null"
                        android:layout_marginEnd="14dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Practice makes perfect"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Real-time AI coaching during your mock interview"
                            android:textColor="@color/colorTextMuted"
                            android:textSize="13sp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- No API key warning -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardApiKeyWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="#FFF3CD"
                    app:cardCornerRadius="10dp"
                    app:strokeWidth="0dp">

                    <TextView
                        android:id="@+id/tvInterviewApiKeyWarning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="14dp"
                        android:text="Add an API key in Settings to use cloud models."
                        android:textColor="#856404"
                        android:textSize="13sp"/>
                </com.google.android.material.card.MaterialCardView>

                <!-- Cloud model label + spinner -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cloud Model"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <Spinner
                    android:id="@+id/spinnerInterviewModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"/>

                <!-- Role label + spinner -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Interview Role"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <Spinner
                        android:id="@+id/spinnerInterviewRole"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>

                    <ImageButton
                        android:id="@+id/btnEditRole"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_edit_title"
                        android:tint="@color/colorTextMuted"
                        android:background="@android:color/transparent"
                        android:contentDescription="Edit role"
                        android:layout_marginStart="4dp"/>

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddRole"
                    style="@style/AppButtonOutlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="+ Add New Role"
                    android:layout_marginBottom="16dp"/>

                <!-- Custom role input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCustomRole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Custom role name"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="24dp"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCustomRole"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@color/colorTextPrimary"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Transcription engine label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Transcription Engine"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <Spinner
                    android:id="@+id/spinnerTranscriptionMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"/>

                <!-- Whisper model download card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardWhisperModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/colorSurface"
                    app:cardCornerRadius="10dp"
                    app:strokeColor="@color/colorBorder"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <!-- Title row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Voice Transcription (Whisper)"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="13sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvWhisperStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Not downloaded"
                                android:textColor="@color/colorTextMuted"
                                android:textSize="12sp"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvWhisperModelNote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/colorTextMuted"
                            android:textSize="12sp"
                            android:layout_marginBottom="10dp"
                            android:visibility="gone"/>

                        <!-- Model selection radio buttons -->
                        <RadioGroup
                            android:id="@+id/rgWhisperModel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">

                            <RadioButton
                                android:id="@+id/rbModelBaseEn"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="base.en\n142 MB · English"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="12sp"
                                android:checked="true"/>

                            <RadioButton
                                android:id="@+id/rbModelSmall"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="small\n466 MB · Multilingual"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="12sp"/>

                        </RadioGroup>

                        <!-- Per-model description -->
                        <TextView
                            android:id="@+id/tvWhisperModelDesc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="English only"
                            android:textColor="@color/colorTextMuted"
                            android:textSize="12sp"
                            android:layout_marginBottom="10dp"/>

                        <ProgressBar
                            android:id="@+id/progressWhisper"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="100"
                            android:visibility="gone"
                            android:layout_marginBottom="8dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDownloadWhisper"
                            style="@style/AppButtonOutlined"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Download Model (142 MB)"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartInterviewSession"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Start Session"
                    android:backgroundTint="@color/colorPrimary"
                    android:textColor="@color/white"/>

            </LinearLayout>
        </ScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:menu="@menu/nav_drawer_menu"
        app:headerLayout="@layout/nav_drawer_header"/>

</androidx.drawerlayout.widget.DrawerLayout>
